# Healthcare Data Platform - Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=healthcare_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=healthcare_dw

# Snowflake
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=HEALTHCARE_WH
SNOWFLAKE_DATABASE=HEALTHCARE_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=SYSADMIN

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your-healthcare-data-bucket

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Airflow
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__FERNET_KEY=your_airflow_fernet_key

# Application
ENV=development
LOG_LEVEL=INFO
